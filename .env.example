# Copia este archivo a .env.local y llena los valores reales.
# .env.local NUNCA se sube a git (ver .gitignore).

# ---- Supabase (sistema nuevo de API keys) ----
# URL y publishable key: Project Settings → API en el dashboard de Supabase.
# La publishable key es segura para el navegador (empieza con sb_publishable_).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (empieza con sb_secret_...). SOLO en el servidor — nunca con
# el prefijo NEXT_PUBLIC_, nunca en código que corra en el navegador.
SUPABASE_SECRET_KEY=

# ---- Stripe (modo prueba) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Se obtiene al crear el webhook en el dashboard de Stripe (Etapa 2).
STRIPE_WEBHOOK_SECRET=

# ---- Anthropic (TutorIA, Etapa 4) ----
ANTHROPIC_API_KEY=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
